<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The theme the activity runs under once Compose takes over. windowBackground is
         vault ink — the launch window's own colour — so no white frame flashes between
         the launch window and the first composed screen. -->
    <style name="Theme.SecureVault" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/vault_ink</item>
    </style>

    <!-- The launch window: the shield-on-ink mark shown until Compose draws its first
         frame. Swapped for Theme.SecureVault by installSplashScreen() in MainActivity. -->
    <style name="Theme.SecureVault.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vault_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_shield</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/vault_ink_deep</item>
        <item name="postSplashScreenTheme">@style/Theme.SecureVault</item>
    </style>
</resources>
