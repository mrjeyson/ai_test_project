<?xml version="1.0" encoding="utf-8"?>
<!-- Declared by the module that needs them, not by :app — the same rule the location
     permission follows in :feature:home. Everything here belongs to one capability:
     raising a local alert at each prayer time. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API 33+. Runtime-granted, and the prayer screen is what asks for it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- API 31+. SCHEDULE_EXACT_ALARM rather than USE_EXACT_ALARM: the latter is
         auto-granted but restricted to alarm-clock and calendar apps, and this is neither.
         The user can revoke this one from Settings, which is why the scheduler always has
         an inexact fallback rather than assuming the grant. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Pending alarms do not survive a restart, so without this the alerts stop at the
         first reboot and never resume. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!-- Fully-qualified names, not the `.notification.X` shorthand: a relative name in
             a *library* manifest is resolved against the merged application's package, not
             this module's, and would point at a class that does not exist. -->

        <!-- exported="false": nothing outside the app has any business firing a prayer
             alert, and the only sender is a PendingIntent this app created. -->
        <receiver
            android:name="com.example.test_ai_project.core.data.notification.PrayerAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name="com.example.test_ai_project.core.data.notification.PrayerBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
