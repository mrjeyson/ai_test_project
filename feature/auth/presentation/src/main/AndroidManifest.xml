<?xml version="1.0" encoding="utf-8"?>
<!-- Declared by the feature that needs them, not by :app — the permission travels with
     the module, so removing the feature removes the permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />

    <!-- required="false": the app is still installable and usable on a device with no
         front camera; the screen reports the failure instead. -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />

</manifest>
