<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon for a prayer alert.

     Solid white on transparent, and filled rather than stroked: the system reduces a
     notification icon to its alpha channel and tints the result, so any colour here is
     discarded and thin outlines disappear at status-bar size. The same clock face as the
     tab icon, redrawn as a silhouette. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Ring: an outer circle with an inner circle wound the same way, so the even-odd
         fill leaves a hole rather than a disc. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,4.4 A7.6,7.6 0 1,1 12,19.6 A7.6,7.6 0 1,1 12,4.4 Z" />
    <!-- Hands, pointing at roughly four o'clock. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11,6.6 H13 V12.3 H11 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M11.4,11.5 L16.1,14.2 L15.1,15.9 L10.4,13.2 Z" />
</vector>
